# ---------------------------------------------------------------------------
# Argentina Dispensary CDMS - production environment template
#
# Copy to a real env file OUTSIDE the repository, e.g.
#   sudo install -m 600 /dev/null /etc/cdms/cdms.env
#   sudo nano /etc/cdms/cdms.env
# then load it with:  set -a; . /etc/cdms/cdms.env; set +a
#
# Every value below is a PLACEHOLDER except the domain names. Never commit a
# filled-in copy of this file. Values are shown as <...> on purpose.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<generate-a-50-plus-character-random-value>
DJANGO_DEBUG=0

# --- Domain ----------------------------------------------------------------
# Both the apex and the www host must be listed.
DJANGO_ALLOWED_HOSTS=makongatiarg.co.tz,www.makongatiarg.co.tz

# Origins permitted to POST forms. Scheme is required; bare hosts are
# upgraded to https automatically.
DJANGO_CSRF_TRUSTED_ORIGINS=https://makongatiarg.co.tz,https://www.makongatiarg.co.tz

# --- Database (MySQL) ------------------------------------------------------
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email (password reset) ------------------------------------------------
# Use the Gmail App Password created after revoking the old one.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=<gmail-address>
DJANGO_EMAIL_HOST_PASSWORD=<new-app-password>
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_DEFAULT_FROM_EMAIL=<gmail-address>

# --- HTTPS -----------------------------------------------------------------
# Only turn these on once the certificate is installed, otherwise the site
# redirects to https and nothing answers.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1

# --- Web server ------------------------------------------------------------
# Leave PORT unset when nginx proxies to a unix socket or 127.0.0.1:8000.
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120

# --- Media storage (optional) ---------------------------------------------
# Set AWS_STORAGE_BUCKET_NAME to store patient documents, QR codes and
# ultrasound images in object storage. Leave it unset to use a local
# persistent volume served by nginx.
# AWS_STORAGE_BUCKET_NAME=<bucket-name>
# AWS_ACCESS_KEY_ID=<access-key-id>
# AWS_SECRET_ACCESS_KEY=<secret-access-key>
# AWS_S3_REGION_NAME=<region>
# AWS_S3_ENDPOINT_URL=<endpoint-for-non-aws>
# AWS_S3_CUSTOM_DOMAIN=<cdn-or-public-domain>
# AWS_QUERYSTRING_AUTH=1
