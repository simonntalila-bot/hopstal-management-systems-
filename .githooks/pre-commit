#!/bin/sh
# ---------------------------------------------------------------------------
# CDMS pre-commit guard
#
# Blocks accidental commits of local configuration and credentials.
# Enabled for every clone via:  git config core.hooksPath .githooks
#
# Three checks:
#   1. deny-listed paths   (.env*, local_settings.py, keys, certs, databases)
#   2. credential literals (quoted, unquoted, YAML, KEY=value styles)
#   3. env-var usage is allow-listed, so os.environ.get(...) still commits
#
# False positives are possible; in that case bypass deliberately with
#   git commit --no-verify
# and fix the value properly rather than committing it.
# ---------------------------------------------------------------------------
set -eu

fail() {
    printf '\n[pre-commit] BLOCKED: %s\n\n' "$1" >&2
    printf 'Reviewed the items above. If this is a false positive, re-run with:\n' >&2
    printf '  git commit --no-verify\n\n' >&2
    exit 1
}

# --- 1. deny-listed paths ---------------------------------------------------
# Local config, credentials, keys, databases and backup archives.
# - .env*                     environment files
# - local_settings.py         developer machine settings
# - creds/credentials*.json   credential blobs
# - secrets.y(a)ml            credential blobs
# - .netrc .pgpass my.cnf     database client credentials
# - *.pem *.key *.p12 ...     keys and certificates
# - *.sqlite3 *.db *.dump    databases
# - *.sql *.sql.gz *.bundle   database dumps
# - *.zip *.tar.gz *.tgz ...  archives that may contain dumps
# - backups/ backup-*         backup output directories and files
#
# .env.example / .env.sample / .env.template are let through: they are
# templates of variable NAMES and are meant to be committed.
denied=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei \
    '(^|/)(\.env([^/]*)?|local_settings\.py|.*\.(pem|key|p12|pfx|jks|keystore|asc|gpg)|id_rsa[^/]*|id_ed25519[^/]*|creds?[^/]*\.json|credentials?[^/]*\.json|secrets?\.ya?ml|\.netrc|\.pgpass|my\.cnf|.*\.(sqlite3?|db|dump|dump\.gz|sql|sql\.gz|sql\.bz2|sql\.xz|sql\.zst|bundle|bak|zip|tar\.gz|tgz|tbz2|7z|rar)|backups?/[^/]*|backup-[^/]*)$' \
    | grep -Eiv '(^|/)\.env\.(example|sample|template)$' \
    || true)

if [ -n "$denied" ]; then
    fail "local config / secret files are staged:
$(printf '%s\n' "$denied" | sed 's/^/  - /')"
fi

# --- 2. credential literals in staged content --------------------------------
# Added lines only, comments stripped.
added=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | \
    sed -e 's/^+//' -e 's/^[[:space:]]*#.*//' -e 's/^[[:space:]]*;.*//' || true)

# Keyword, optional closing quote, separator, then a literal value.
# Built with double quotes so a single quote needs no escaping.
q="[\"']"
keyword="(password|passwd|pwd|secret|api[_-]?key|access[_-]?token|private[_-]?key|client[_-]?secret|credential)"
bare="[A-Za-z0-9_@!$%^&*+=./:-]{4,}"
quoted="$q[^\"']{4,}$q"

pattern="$keyword[A-Za-z0-9_]*[\"']?[[:space:]]*[:=][[:space:]]*($quoted|$bare)"
envstyle="^[A-Z][A-Z0-9_]*(PASSWORD|PASSWD|PWD|SECRET|API_?KEY|TOKEN|PRIVATE_?KEY|CREDENTIALS?)[A-Z0-9_]*="

# Allow-list: env-var reads, placeholders, validators, settings indirection,
# throwaway fixtures used by the automated test suite, and values that are
# read from an attribute rather than written as a literal.
allow='os\.environ|getenv|environ\.get|settings\.|^[[:space:]]*(import|from) |REDACTED|REMOVED-ROTATE|\*\*\*|get_random_secret_key|AUTH_PASSWORD_VALIDATORS|password_validation|DB_PASSWORD"|TestPass|test[-_]?password|wrong[-_]?password|dummy[-_]?password|placeholder|example[-_]?password|s3v4|max-age=|<[^>]+>|\b(self|cls|request|obj|user|form|data|kwargs|config|options|context)\.[A-Za-z_]'

hits=$(printf '%s\n' "$added" | grep -Ei "$pattern" | grep -Eiv "$allow" || true)
hits2=$(printf '%s\n' "$added" | grep -Ei "$envstyle" | grep -Eiv "$allow" || true)

if [ -n "$hits" ] || [ -n "$hits2" ]; then
    fail "possible hard-coded credential in staged lines:
$(printf '%s\n%s\n' "$hits" "$hits2" | grep -v '^[[:space:]]*$' | cut -c1-120 | sed 's/^/  - /')"
fi

exit 0
